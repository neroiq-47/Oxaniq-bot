# Oxaniq Configuration Example
# Copy to .env and fill in real values. Never commit .env

# Mode
PAPER_TRADING=true
LOG_LEVEL=INFO

# Solana / Helius (recommended)
HELIUS_API_KEY=your-helius-key-here
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your-helius-key-here

# Jupiter API
JUPITER_API_KEY=your-jupiter-key-here

# Wallet (leave empty for pure paper mode)
SOLANA_PRIVATE_KEY=
WALLET_PUBKEY=

# Risk Limits (SOL units)
MAX_POSITION_SIZE_SOL=0.05
MAX_OPEN_POSITIONS=3
DAILY_LOSS_LIMIT_SOL=0.2
MAX_SLIPPAGE_BPS=300
MIN_CONFIDENCE_SCORE=0.40

# Pump.fun
PUMPFUN_API=https://frontend-api.pump.fun
PUMPPORTAL_WS=wss://pumpportal.fun/api/data

# FOMO (stubs)
FOMO_API_URL=
FOMO_API_KEY=

# x402
X402_FACILITATOR_URL=https://payai.network
X402_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
X402_DAILY_SPEND_LIMIT_USDC=5.0
X402_ENABLED=false

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TAKE_PROFIT_PCT=0.15
STOP_LOSS_PCT=0.08
MAX_HOLD_SECONDS=300
TELEGRAM_ADMIN_IDS=
WALLET_MASTER_KEY=

# Platform fee (50 bps = 0.5%)
PLATFORM_FEE_BPS=50
PLATFORM_VAULT=92gMu7MDKw5CuGxGKjUbaDx2BeuFBo9ttUkJSb7yABM1

MAX_CALLS_PER_DAY=20

MIN_CALL_SCORE=0.30

MIN_CALL_CONFIDENCE=0.28

TG_RATE_PER_MIN=30

# PumpDev live stream
PUMPDEV_WS=wss://pumpdev.io/ws
PUMPDEV_API_KEY=

CALL_MODE=trade

LIVE_ENABLED=false

MIN_CURVE_SOL=2

MAX_CURVE_SOL=40

MAX_CALL_MCAP_SOL=30

MAX_DEV_BUY_SOL=2

ACCESS_PRICE_USD=11.99
ACCESS_REQUIRED=true

TELEGRAM_CHANNEL=@OxanIQ_pump
TELEGRAM_CHANNEL_ID=

VYBE_API=https://api.vybenetwork.xyz
VYBE_API_KEY=
